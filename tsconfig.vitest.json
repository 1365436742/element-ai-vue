{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["node", "jsdom", "vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "packages",
    "vitest.setup.ts",
    "vitest.config.mts",
    "typings/env.d.ts",
    "internal/vue-types/compiler.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/*.md", "packages/uniapp-polyfill"]
}
